DEEPSEEK_API_KEY=sk-xxxxxxx

# --- Global city OSM data (phase 1) ---
# Radius in metres around the geocoded city centre. 0 = fetch the whole city
# with OSMnx features_from_place/graph_from_place (much slower for megacities).
GEOAI_OSM_RADIUS_M=5000
# Per-city overrides are optional, e.g. GEOAI_OSM_RADIUS_TOKYO=3000
GEOAI_OSM_TIMEOUT_S=180
GEOAI_OSM_CACHE_TTL_S=86400
GEOAI_OSM_MAX_FEATURES=20000
GEOAI_OSM_SIMPLIFY_M=0
# Please identify your app to OSM: https://operations.osmfoundation.org/policies/
GEOAI_OSM_USER_AGENT=GeoAI/0.1 (your-contact)
# Comma-separated Overpass mirrors, tried in order on failure
GEOAI_OVERPASS_URLS=https://overpass-api.de/api,https://overpass.kumi.systems/api
